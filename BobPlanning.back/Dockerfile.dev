FROM node:lts-alpine3.22

WORKDIR /usr/src/app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./
COPY nodemon.json ./

# Install ALL dependencies (including dev dependencies for HMR in development)
RUN npm ci

# Copy source code
COPY . .

EXPOSE 3000

# Run development server with nodemon
CMD ["npm", "run", "dev"]
