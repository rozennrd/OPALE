{
  "compilerOptions": {
    "target": "es6",                      
    "module": "commonjs",                  
    "strict": true,                        
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,                  
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",                   
    "rootDir": "./src",
    "typeRoots": ["./node_modules/@types", "./src/types"]                    
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}